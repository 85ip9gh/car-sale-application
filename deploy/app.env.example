# Copy to deploy/app.env on the host, fill in real values, then chmod 0600.
# app.env is gitignored and must never be committed.
#
# Use alphanumeric passwords. Compose interpolates this file, so a literal '$'
# in a value is treated as a variable reference and silently corrupts it.

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=pesanth
MYSQL_USER=carsale
MYSQL_PASSWORD=changeme

# Exact public origin. Not a wildcard.
APP_CORS_ALLOWED_ORIGINS=https://carsale.pesanth.com

# Bind to the Tailscale address so the only public path is Cloudflare Tunnel.
BIND_ADDRESS=100.79.13.73
BIND_PORT=4243
